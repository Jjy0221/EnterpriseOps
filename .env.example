APP_NAME=EnterpriseOps Copilot

MILVUS_URI=http://localhost:19530
MILVUS_DB=enterpriseops
MILVUS_COLLECTION=knowledge_chunks

# Embedding：实际可用的 OpenAI-compatible 接口
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL_NAME=text-embedding-v4
EMBED_DIM=1024
EMBED_BATCH_SIZE=10

# Chat：实际可用的 OpenAI-compatible 接口
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL_NAME=

CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5

# SQLite
DATABASE_URL=sqlite:///./enterpriseops.db

ENABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=600
